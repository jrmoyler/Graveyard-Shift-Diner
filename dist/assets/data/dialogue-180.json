[
  {
    "id": "no-reflection-00",
    "tell": "no-reflection",
    "line": "Funny little mirror on that dispenser."
  },
  {
    "id": "no-reflection-01",
    "tell": "no-reflection",
    "line": "Nothing worth looking at behind me."
  },
  {
    "id": "no-reflection-02",
    "tell": "no-reflection",
    "line": "I prefer the window to polished metal."
  },
  {
    "id": "no-reflection-03",
    "tell": "no-reflection",
    "line": "That chrome is cleaner than I expected."
  },
  {
    "id": "no-reflection-04",
    "tell": "no-reflection",
    "line": "You keep checking that silver box."
  },
  {
    "id": "no-reflection-05",
    "tell": "no-reflection",
    "line": "There is nothing for me in that mirror."
  },
  {
    "id": "no-reflection-06",
    "tell": "no-reflection",
    "line": "I sit where the chrome is quiet."
  },
  {
    "id": "no-reflection-07",
    "tell": "no-reflection",
    "line": "Don't trouble yourself polishing it for me."
  },
  {
    "id": "no-reflection-08",
    "tell": "no-reflection",
    "line": "The napkins will do. Leave the mirror."
  },
  {
    "id": "no-reflection-09",
    "tell": "no-reflection",
    "line": "I have no use for another look at myself."
  },
  {
    "id": "cold-coffee-00",
    "tell": "cold-coffee",
    "line": "The warmth never lasts near me."
  },
  {
    "id": "cold-coffee-01",
    "tell": "cold-coffee",
    "line": "Cold already. Leave it that way."
  },
  {
    "id": "cold-coffee-02",
    "tell": "cold-coffee",
    "line": "I drink it however it arrives."
  },
  {
    "id": "cold-coffee-03",
    "tell": "cold-coffee",
    "line": "No steam. That suits me."
  },
  {
    "id": "cold-coffee-04",
    "tell": "cold-coffee",
    "line": "You just poured it? I hadn't noticed."
  },
  {
    "id": "cold-coffee-05",
    "tell": "cold-coffee",
    "line": "Don't warm the cup again."
  },
  {
    "id": "cold-coffee-06",
    "tell": "cold-coffee",
    "line": "The heat goes quickly at this table."
  },
  {
    "id": "cold-coffee-07",
    "tell": "cold-coffee",
    "line": "I never ask for a second warming."
  },
  {
    "id": "cold-coffee-08",
    "tell": "cold-coffee",
    "line": "Let it cool. It won't take long."
  },
  {
    "id": "cold-coffee-09",
    "tell": "cold-coffee",
    "line": "Keep the hot pot away from my hands."
  },
  {
    "id": "knows-name-00",
    "tell": "knows-name",
    "line": "Long night, {name}?"
  },
  {
    "id": "knows-name-01",
    "tell": "knows-name",
    "line": "You look tired, {name}."
  },
  {
    "id": "knows-name-02",
    "tell": "knows-name",
    "line": "Still pouring, {name}?"
  },
  {
    "id": "knows-name-03",
    "tell": "knows-name",
    "line": "Same counter, same {name}."
  },
  {
    "id": "knows-name-04",
    "tell": "knows-name",
    "line": "I knew you'd be here, {name}."
  },
  {
    "id": "knows-name-05",
    "tell": "knows-name",
    "line": "You needn't introduce yourself, {name}."
  },
  {
    "id": "knows-name-06",
    "tell": "knows-name",
    "line": "How's the shift treating you, {name}?"
  },
  {
    "id": "knows-name-07",
    "tell": "knows-name",
    "line": "I remember your name, {name}."
  },
  {
    "id": "knows-name-08",
    "tell": "knows-name",
    "line": "That apron belongs to you, {name}."
  },
  {
    "id": "knows-name-09",
    "tell": "knows-name",
    "line": "Good to see you working, {name}."
  },
  {
    "id": "wet-footprints-00",
    "tell": "wet-footprints",
    "line": "My boots have brought the road inside."
  },
  {
    "id": "wet-footprints-01",
    "tell": "wet-footprints",
    "line": "Those prints may stay a while."
  },
  {
    "id": "wet-footprints-02",
    "tell": "wet-footprints",
    "line": "I wiped my feet. It doesn't help."
  },
  {
    "id": "wet-footprints-03",
    "tell": "wet-footprints",
    "line": "The floor won't dry under my chair."
  },
  {
    "id": "wet-footprints-04",
    "tell": "wet-footprints",
    "line": "No need to mop around me yet."
  },
  {
    "id": "wet-footprints-05",
    "tell": "wet-footprints",
    "line": "Wet soles. It has been a long walk."
  },
  {
    "id": "wet-footprints-06",
    "tell": "wet-footprints",
    "line": "I leave more water than I mean to."
  },
  {
    "id": "wet-footprints-07",
    "tell": "wet-footprints",
    "line": "The marks follow me indoors."
  },
  {
    "id": "wet-footprints-08",
    "tell": "wet-footprints",
    "line": "I know. Those are my bootprints."
  },
  {
    "id": "wet-footprints-09",
    "tell": "wet-footprints",
    "line": "Don't waste another towel on the floor."
  },
  {
    "id": "echo-sentence-00",
    "tell": "echo-sentence",
    "line": "{previous_sentence}"
  },
  {
    "id": "echo-sentence-01",
    "tell": "echo-sentence",
    "line": "You said: {previous_sentence}"
  },
  {
    "id": "echo-sentence-02",
    "tell": "echo-sentence",
    "line": "Was it: {previous_sentence}"
  },
  {
    "id": "echo-sentence-03",
    "tell": "echo-sentence",
    "line": "Again: {previous_sentence}"
  },
  {
    "id": "echo-sentence-04",
    "tell": "echo-sentence",
    "line": "Your words: {previous_sentence}"
  },
  {
    "id": "echo-sentence-05",
    "tell": "echo-sentence",
    "line": "I heard: {previous_sentence}"
  },
  {
    "id": "echo-sentence-06",
    "tell": "echo-sentence",
    "line": "Just so: {previous_sentence}"
  },
  {
    "id": "echo-sentence-07",
    "tell": "echo-sentence",
    "line": "As you put it: {previous_sentence}"
  },
  {
    "id": "echo-sentence-08",
    "tell": "echo-sentence",
    "line": "You asked: {previous_sentence}"
  },
  {
    "id": "echo-sentence-09",
    "tell": "echo-sentence",
    "line": "I will repeat it: {previous_sentence}"
  },
  {
    "id": "refuses-salt-00",
    "tell": "refuses-salt",
    "line": "No salt for me."
  },
  {
    "id": "refuses-salt-01",
    "tell": "refuses-salt",
    "line": "Please leave the shaker elsewhere."
  },
  {
    "id": "refuses-salt-02",
    "tell": "refuses-salt",
    "line": "I won't touch the salt."
  },
  {
    "id": "refuses-salt-03",
    "tell": "refuses-salt",
    "line": "Take that off my table, please."
  },
  {
    "id": "refuses-salt-04",
    "tell": "refuses-salt",
    "line": "The food needs nothing from that shaker."
  },
  {
    "id": "refuses-salt-05",
    "tell": "refuses-salt",
    "line": "Not one grain, thank you."
  },
  {
    "id": "refuses-salt-06",
    "tell": "refuses-salt",
    "line": "I have no use for salt tonight."
  },
  {
    "id": "refuses-salt-07",
    "tell": "refuses-salt",
    "line": "Put the salt back on the counter."
  },
  {
    "id": "refuses-salt-08",
    "tell": "refuses-salt",
    "line": "Keep that white shaker away."
  },
  {
    "id": "refuses-salt-09",
    "tell": "refuses-salt",
    "line": "I said no salt. I mean it."
  },
  {
    "id": "extra-knuckles-00",
    "tell": "extra-knuckles",
    "line": "The glove never fits quite right."
  },
  {
    "id": "extra-knuckles-01",
    "tell": "extra-knuckles",
    "line": "My fingers fold in curious places."
  },
  {
    "id": "extra-knuckles-02",
    "tell": "extra-knuckles",
    "line": "I keep that hand covered."
  },
  {
    "id": "extra-knuckles-03",
    "tell": "extra-knuckles",
    "line": "The seams pull across my fingers."
  },
  {
    "id": "extra-knuckles-04",
    "tell": "extra-knuckles",
    "line": "Don't ask me to take the glove off."
  },
  {
    "id": "extra-knuckles-05",
    "tell": "extra-knuckles",
    "line": "There is another bend beneath the leather."
  },
  {
    "id": "extra-knuckles-06",
    "tell": "extra-knuckles",
    "line": "The cuff hides less than I wish."
  },
  {
    "id": "extra-knuckles-07",
    "tell": "extra-knuckles",
    "line": "That finger bends once more."
  },
  {
    "id": "extra-knuckles-08",
    "tell": "extra-knuckles",
    "line": "I know what you are counting."
  },
  {
    "id": "extra-knuckles-09",
    "tell": "extra-knuckles",
    "line": "My hand has always been difficult to measure."
  },
  {
    "id": "shadow-offset-00",
    "tell": "shadow-offset",
    "line": "Don't mind the shape beside my chair."
  },
  {
    "id": "shadow-offset-01",
    "tell": "shadow-offset",
    "line": "The light never finds me squarely."
  },
  {
    "id": "shadow-offset-02",
    "tell": "shadow-offset",
    "line": "That shadow is mine, I suppose."
  },
  {
    "id": "shadow-offset-03",
    "tell": "shadow-offset",
    "line": "The floor has its own idea of me."
  },
  {
    "id": "shadow-offset-04",
    "tell": "shadow-offset",
    "line": "I see you checking the light."
  },
  {
    "id": "shadow-offset-05",
    "tell": "shadow-offset",
    "line": "My outline leans a little differently."
  },
  {
    "id": "shadow-offset-06",
    "tell": "shadow-offset",
    "line": "The lamp and I don't quite agree."
  },
  {
    "id": "shadow-offset-07",
    "tell": "shadow-offset",
    "line": "I don't stand where my shadow points."
  },
  {
    "id": "shadow-offset-08",
    "tell": "shadow-offset",
    "line": "There's no reason to follow that dark patch."
  },
  {
    "id": "shadow-offset-09",
    "tell": "shadow-offset",
    "line": "Leave the light where it is."
  },
  {
    "id": "usual-first-visit-00",
    "tell": "usual-first-visit",
    "line": "The usual, please."
  },
  {
    "id": "usual-first-visit-01",
    "tell": "usual-first-visit",
    "line": "You know my order, surely."
  },
  {
    "id": "usual-first-visit-02",
    "tell": "usual-first-visit",
    "line": "Bring what you always bring me."
  },
  {
    "id": "usual-first-visit-03",
    "tell": "usual-first-visit",
    "line": "No menu. My usual plate."
  },
  {
    "id": "usual-first-visit-04",
    "tell": "usual-first-visit",
    "line": "Same as last time."
  },
  {
    "id": "usual-first-visit-05",
    "tell": "usual-first-visit",
    "line": "The usual coffee and the usual seat."
  },
  {
    "id": "usual-first-visit-06",
    "tell": "usual-first-visit",
    "line": "You remember what I take."
  },
  {
    "id": "usual-first-visit-07",
    "tell": "usual-first-visit",
    "line": "Don't make me name my order again."
  },
  {
    "id": "usual-first-visit-08",
    "tell": "usual-first-visit",
    "line": "Whatever I had before will do."
  },
  {
    "id": "usual-first-visit-09",
    "tell": "usual-first-visit",
    "line": "I've already told you. The usual."
  },
  {
    "id": "drawn-to-neon-00",
    "tell": "drawn-to-neon",
    "line": "That red light. Leave it on."
  },
  {
    "id": "drawn-to-neon-01",
    "tell": "drawn-to-neon",
    "line": "I can see the sign from this seat."
  },
  {
    "id": "drawn-to-neon-02",
    "tell": "drawn-to-neon",
    "line": "May I sit nearer the red tube?"
  },
  {
    "id": "drawn-to-neon-03",
    "tell": "drawn-to-neon",
    "line": "The neon is the only thing I watch."
  },
  {
    "id": "drawn-to-neon-04",
    "tell": "drawn-to-neon",
    "line": "Don't turn the sign off yet."
  },
  {
    "id": "drawn-to-neon-05",
    "tell": "drawn-to-neon",
    "line": "I lose my place when that light dims."
  },
  {
    "id": "drawn-to-neon-06",
    "tell": "drawn-to-neon",
    "line": "Red is easy to follow."
  },
  {
    "id": "drawn-to-neon-07",
    "tell": "drawn-to-neon",
    "line": "The sign keeps pulling my eye."
  },
  {
    "id": "drawn-to-neon-08",
    "tell": "drawn-to-neon",
    "line": "A chair below the neon, please."
  },
  {
    "id": "drawn-to-neon-09",
    "tell": "drawn-to-neon",
    "line": "I came in because of that red light."
  },
  {
    "id": "sleeve-dust-00",
    "tell": "sleeve-dust",
    "line": "Don't brush my sleeve."
  },
  {
    "id": "sleeve-dust-01",
    "tell": "sleeve-dust",
    "line": "That pale dust clings to wool."
  },
  {
    "id": "sleeve-dust-02",
    "tell": "sleeve-dust",
    "line": "I've carried this dust for miles."
  },
  {
    "id": "sleeve-dust-03",
    "tell": "sleeve-dust",
    "line": "Leave the powder where it settled."
  },
  {
    "id": "sleeve-dust-04",
    "tell": "sleeve-dust",
    "line": "The sleeve sheds if you touch it."
  },
  {
    "id": "sleeve-dust-05",
    "tell": "sleeve-dust",
    "line": "I know there's dust on my cuff."
  },
  {
    "id": "sleeve-dust-06",
    "tell": "sleeve-dust",
    "line": "It isn't flour. Don't taste it."
  },
  {
    "id": "sleeve-dust-07",
    "tell": "sleeve-dust",
    "line": "That coat has its own dust."
  },
  {
    "id": "sleeve-dust-08",
    "tell": "sleeve-dust",
    "line": "A dry brush won't clear my sleeve."
  },
  {
    "id": "sleeve-dust-09",
    "tell": "sleeve-dust",
    "line": "Keep your apron away from this cuff."
  },
  {
    "id": "never-blinks-00",
    "tell": "never-blinks",
    "line": "I keep my eyes open."
  },
  {
    "id": "never-blinks-01",
    "tell": "never-blinks",
    "line": "I haven't closed my eyes all night."
  },
  {
    "id": "never-blinks-02",
    "tell": "never-blinks",
    "line": "You can stop watching for a blink."
  },
  {
    "id": "never-blinks-03",
    "tell": "never-blinks",
    "line": "I see better without looking away."
  },
  {
    "id": "never-blinks-04",
    "tell": "never-blinks",
    "line": "My eyes don't tire as yours do."
  },
  {
    "id": "never-blinks-05",
    "tell": "never-blinks",
    "line": "The lids can wait."
  },
  {
    "id": "never-blinks-06",
    "tell": "never-blinks",
    "line": "Nothing passes while I look away."
  },
  {
    "id": "never-blinks-07",
    "tell": "never-blinks",
    "line": "I have held this gaze for some time."
  },
  {
    "id": "never-blinks-08",
    "tell": "never-blinks",
    "line": "Yes, I'm still looking."
  },
  {
    "id": "never-blinks-09",
    "tell": "never-blinks",
    "line": "There's no need to blink just now."
  },
  {
    "id": "duplicate-regular-00",
    "tell": "duplicate-regular",
    "line": "You think you've seen me tonight."
  },
  {
    "id": "duplicate-regular-01",
    "tell": "duplicate-regular",
    "line": "The other face isn't my concern."
  },
  {
    "id": "duplicate-regular-02",
    "tell": "duplicate-regular",
    "line": "There may be someone like me nearby."
  },
  {
    "id": "duplicate-regular-03",
    "tell": "duplicate-regular",
    "line": "You keep looking at that other table."
  },
  {
    "id": "duplicate-regular-04",
    "tell": "duplicate-regular",
    "line": "I can't help whom I resemble."
  },
  {
    "id": "duplicate-regular-05",
    "tell": "duplicate-regular",
    "line": "My face has never been unique."
  },
  {
    "id": "duplicate-regular-06",
    "tell": "duplicate-regular",
    "line": "Seat me. Don't keep comparing us."
  },
  {
    "id": "duplicate-regular-07",
    "tell": "duplicate-regular",
    "line": "I know there is another one of us."
  },
  {
    "id": "duplicate-regular-08",
    "tell": "duplicate-regular",
    "line": "You noticed the resemblance quickly."
  },
  {
    "id": "duplicate-regular-09",
    "tell": "duplicate-regular",
    "line": "The person already seated is not my problem."
  },
  {
    "id": "mirrored-hair-00",
    "tell": "mirrored-hair",
    "line": "My hair falls to this side."
  },
  {
    "id": "mirrored-hair-01",
    "tell": "mirrored-hair",
    "line": "You remember the part differently."
  },
  {
    "id": "mirrored-hair-02",
    "tell": "mirrored-hair",
    "line": "It is combed the other way tonight."
  },
  {
    "id": "mirrored-hair-03",
    "tell": "mirrored-hair",
    "line": "That side of my face is unfamiliar?"
  },
  {
    "id": "mirrored-hair-04",
    "tell": "mirrored-hair",
    "line": "I have changed nothing but the part."
  },
  {
    "id": "mirrored-hair-05",
    "tell": "mirrored-hair",
    "line": "The mirror favors the opposite side."
  },
  {
    "id": "mirrored-hair-06",
    "tell": "mirrored-hair",
    "line": "Look at the hairline if you like."
  },
  {
    "id": "mirrored-hair-07",
    "tell": "mirrored-hair",
    "line": "It is a small difference, isn't it?"
  },
  {
    "id": "mirrored-hair-08",
    "tell": "mirrored-hair",
    "line": "The part has always been here for me."
  },
  {
    "id": "mirrored-hair-09",
    "tell": "mirrored-hair",
    "line": "You keep studying which way it falls."
  },
  {
    "id": "wrong-hand-00",
    "tell": "wrong-hand",
    "line": "I use this hand tonight."
  },
  {
    "id": "wrong-hand-01",
    "tell": "wrong-hand",
    "line": "The other hand can rest."
  },
  {
    "id": "wrong-hand-02",
    "tell": "wrong-hand",
    "line": "You expected me to reach differently."
  },
  {
    "id": "wrong-hand-03",
    "tell": "wrong-hand",
    "line": "I sign with this hand now."
  },
  {
    "id": "wrong-hand-04",
    "tell": "wrong-hand",
    "line": "This is the hand I'll pay with."
  },
  {
    "id": "wrong-hand-05",
    "tell": "wrong-hand",
    "line": "Don't move the cup to the other side."
  },
  {
    "id": "wrong-hand-06",
    "tell": "wrong-hand",
    "line": "You remember my hands too well."
  },
  {
    "id": "wrong-hand-07",
    "tell": "wrong-hand",
    "line": "I reach across rather than around."
  },
  {
    "id": "wrong-hand-08",
    "tell": "wrong-hand",
    "line": "This hand knows what to do."
  },
  {
    "id": "wrong-hand-09",
    "tell": "wrong-hand",
    "line": "You noticed which hand moved first."
  },
  {
    "id": "no-car-00",
    "tell": "no-car",
    "line": "I didn't park outside."
  },
  {
    "id": "no-car-01",
    "tell": "no-car",
    "line": "There is no car waiting for me."
  },
  {
    "id": "no-car-02",
    "tell": "no-car",
    "line": "I came on foot."
  },
  {
    "id": "no-car-03",
    "tell": "no-car",
    "line": "You won't find my ride by the lamps."
  },
  {
    "id": "no-car-04",
    "tell": "no-car",
    "line": "The road brought me here without a car."
  },
  {
    "id": "no-car-05",
    "tell": "no-car",
    "line": "No keys. No vehicle."
  },
  {
    "id": "no-car-06",
    "tell": "no-car",
    "line": "I have nothing parked beyond the glass."
  },
  {
    "id": "no-car-07",
    "tell": "no-car",
    "line": "Don't look for a car on my account."
  },
  {
    "id": "no-car-08",
    "tell": "no-car",
    "line": "No engine carried me tonight."
  },
  {
    "id": "no-car-09",
    "tell": "no-car",
    "line": "I'll leave the way I arrived. Walking."
  },
  {
    "id": "cold-breath-00",
    "tell": "cold-breath",
    "line": "My breath makes clouds even in here."
  },
  {
    "id": "cold-breath-01",
    "tell": "cold-breath",
    "line": "I brought the cold inside."
  },
  {
    "id": "cold-breath-02",
    "tell": "cold-breath",
    "line": "That little cloud was my breath."
  },
  {
    "id": "cold-breath-03",
    "tell": "cold-breath",
    "line": "It never feels warm where I sit."
  },
  {
    "id": "cold-breath-04",
    "tell": "cold-breath",
    "line": "You can see every breath I take."
  },
  {
    "id": "cold-breath-05",
    "tell": "cold-breath",
    "line": "The room hasn't warmed my lungs."
  },
  {
    "id": "cold-breath-06",
    "tell": "cold-breath",
